{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-os/adapter-manifest",
  "title": "Framework adapter manifest (~/.engineering-os/adapters/<id>/adapter.json)",
  "description": "Declares how one universal spec.md/policies.md/tests.md bundle compiles into idiomatic framework files, how the project is bootstrapped, and which deterministic verifiers prove the result.",
  "type": "object",
  "required": ["version", "id", "name", "language", "framework", "runtime", "layout", "typeMap", "layers", "policyBindings", "verifiers", "selection"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string"},
    "language": {"type": "string", "enum": ["python", "typescript", "go", "java", "kotlin", "php", "ruby", "csharp", "rust"]},
    "framework": {"type": "string"},
    "frameworkVersion": {"type": "string"},
    "runtime": {
      "type": "object", "required": ["bootstrap", "install", "test", "serve"], "additionalProperties": false,
      "properties": {
        "bootstrap": {"$ref": "#/$defs/argv", "description": "Creates an empty project skeleton in cwd."},
        "install": {"$ref": "#/$defs/argv"},
        "test": {"$ref": "#/$defs/argv"},
        "lint": {"$ref": "#/$defs/argv"},
        "typecheck": {"$ref": "#/$defs/argv"},
        "serve": {"$ref": "#/$defs/argv", "description": "Starts the API on {port} for Apidog CLI verification."},
        "openapiExport": {"$ref": "#/$defs/argv", "description": "Dumps the framework's own OpenAPI so it can be diffed against the compiled contract."},
        "healthPath": {"type": "string"}
      }
    },
    "layout": {
      "type": "object", "required": ["root", "domainDir"], "additionalProperties": {"type": "string"},
      "properties": {
        "root": {"type": "string", "description": "Source root relative to the project (e.g. app, src)."},
        "domainDir": {"type": "string", "description": "Template with {domain} for a bounded context directory."}
      }
    },
    "typeMap": {
      "type": "object", "description": "JSON-Schema type[/format] -> language type.",
      "additionalProperties": {"type": "string"}
    },
    "layers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "role", "path", "template"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string", "enum": ["model", "schema", "controller", "service", "repository", "test", "wiring", "migration", "policy"]},
          "path": {"type": "string", "description": "File path template using {domain}, {endpoint}, {Endpoint}, {resource}, {Resource}."},
          "template": {"type": "string", "description": "Template file relative to the adapter directory, or inline: prefixed text."},
          "perEndpoint": {"type": "boolean", "default": true},
          "mergeStrategy": {"type": "string", "enum": ["overwrite", "append-section", "regenerate-block"], "default": "regenerate-block"},
          "callGraphSymbols": {"type": "array", "items": {"type": "string"}, "description": "Symbols this layer defines, e.g. \"{Resource}Service.{endpoint}\"; the call-graph checker verifies spec Calls against them."}
        }
      }
    },
    "policyBindings": {
      "type": "object", "description": "How each policies.md key becomes framework code.",
      "additionalProperties": {"type": "object", "required": ["mechanism"], "properties": {"mechanism": {"type": "string"}, "template": {"type": "string"}, "verifier": {"type": "string"}}}
    },
    "verifiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "argv"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["tests", "lint", "typecheck", "call-graph", "openapi-diff", "query-count", "latency", "apidog"]},
          "argv": {"$ref": "#/$defs/argv"},
          "timeoutMs": {"type": "integer", "minimum": 1000},
          "cwd": {"type": "string"}
        }
      }
    },
    "selection": {
      "type": "object", "description": "Scoring profile used by the stack selector.",
      "required": ["strengths"], "additionalProperties": false,
      "properties": {
        "strengths": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}, "description": "Keys: latency, throughput, asyncIo, relationalAdmin, typeSafety, teamTypescript, teamPython, teamGo, teamJava, aiIntegration, enterprise, rapidPrototyping."},
          "notes": {"type": "string"}
      }
    },
    "procedural": {"type": "array", "items": {"type": "string"}, "description": "Blueprint ids this adapter ships in ~/.engineering-os/procedural/."}
  },
  "$defs": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
}
