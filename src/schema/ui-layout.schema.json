{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engineering-os/ui-layout",
  "title": "Declarative generative UI layout",
  "description": "Lightweight JSON a graph stage or agent emits so the workspace shell renders the exact inspection tool needed. Components are a fixed vocabulary; props are component-specific and validated by the shell.",
  "type": "object",
  "required": ["version", "title", "regions"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "subtitle": {"type": "string"},
    "stage": {"type": "string", "description": "Graph node that produced this layout."},
    "grid": {"type": "string", "enum": ["single", "main-side", "main-side-footer", "two-column", "three-column"], "default": "main-side-footer"},
    "regions": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["id", "component", "props"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "enum": ["main", "side", "footer", "header", "left", "center", "right"]},
          "component": {"type": "string", "enum": ["dag", "call-graph", "decision-card", "diff", "evidence-matrix", "markdown", "table", "log-stream", "status-banner", "form", "api-index", "empty"]},
          "title": {"type": "string"},
          "props": {"type": "object"},
          "source": {"type": "object", "description": "Live data binding instead of static props.", "required": ["kind", "ref"], "properties": {"kind": {"type": "string", "enum": ["file", "sse", "http", "task"]}, "ref": {"type": "string"}, "refreshMs": {"type": "integer", "minimum": 250}}}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "label", "kind"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"type": "string", "enum": ["advance", "answer-card", "navigate", "run-check", "open-file", "rerun-unit"]},
          "target": {"type": "string"},
          "payload": {"type": "object"},
          "danger": {"type": "boolean"}
        }
      }
    },
    "ttlMs": {"type": "integer", "minimum": 0, "description": "How long the layout is valid before the shell re-fetches."}
  }
}
