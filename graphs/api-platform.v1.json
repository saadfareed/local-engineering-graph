{
  "id": "api-platform",
  "version": 1,
  "start": "intake",
  "requiredGates": ["stack_selection", "spec_approval", "domain_check", "review", "validation"],
  "evidenceMode": "structured",
  "nodes": {
    "intake": {"type": "agent", "role": "supreme-coordinator", "outcomes": ["ready", "blocked"]},
    "stack_selection": {"type": "approval", "role": "user", "outcomes": ["approved", "rejected"]},
    "contract_design": {"type": "agent", "role": "planner", "outcomes": ["ready", "blocked"]},
    "spec_approval": {"type": "approval", "role": "user", "outcomes": ["approved", "rejected"]},
    "domain_check": {"type": "agent", "role": "domain-coordinator", "outcomes": ["allowed", "question", "blocked"]},
    "clarification": {"type": "approval", "role": "user", "outcomes": ["answered", "rejected"]},
    "swarm_implementation": {"type": "agent", "role": "worker", "outcomes": ["completed", "blocked", "replan"], "submissionOutcome": "completed"},
    "review": {"type": "agent", "role": "reviewer", "outcomes": ["passed", "changes_required", "blocked"]},
    "validation": {"type": "agent", "role": "validator", "outcomes": ["passed", "failed", "blocked"]},
    "consolidation": {"type": "agent", "role": "memory-curator", "outcomes": ["consolidated", "blocked"]},
    "complete": {"type": "terminal", "role": null, "outcomes": [], "success": true},
    "blocked": {"type": "terminal", "role": null, "outcomes": []}
  },
  "edges": [
    {"from": "intake", "outcome": "ready", "to": "stack_selection", "maxTraversals": 3},
    {"from": "intake", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "stack_selection", "outcome": "approved", "to": "contract_design", "maxTraversals": 3},
    {"from": "stack_selection", "outcome": "rejected", "to": "intake", "maxTraversals": 2},
    {"from": "contract_design", "outcome": "ready", "to": "spec_approval", "maxTraversals": 4},
    {"from": "contract_design", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "spec_approval", "outcome": "approved", "to": "domain_check", "maxTraversals": 4},
    {"from": "spec_approval", "outcome": "rejected", "to": "contract_design", "maxTraversals": 3},
    {"from": "domain_check", "outcome": "allowed", "to": "swarm_implementation", "maxTraversals": 4},
    {"from": "domain_check", "outcome": "question", "to": "clarification", "maxTraversals": 3},
    {"from": "domain_check", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "clarification", "outcome": "answered", "to": "contract_design", "maxTraversals": 3},
    {"from": "clarification", "outcome": "rejected", "to": "blocked", "maxTraversals": 1},
    {"from": "swarm_implementation", "outcome": "completed", "to": "review", "maxTraversals": 4},
    {"from": "swarm_implementation", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "swarm_implementation", "outcome": "replan", "to": "spec_approval", "maxTraversals": 2},
    {"from": "review", "outcome": "passed", "to": "validation", "maxTraversals": 4},
    {"from": "review", "outcome": "changes_required", "to": "swarm_implementation", "maxTraversals": 3},
    {"from": "review", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "validation", "outcome": "passed", "to": "consolidation", "maxTraversals": 4},
    {"from": "validation", "outcome": "failed", "to": "swarm_implementation", "maxTraversals": 3},
    {"from": "validation", "outcome": "blocked", "to": "blocked", "maxTraversals": 1},
    {"from": "consolidation", "outcome": "consolidated", "to": "complete", "maxTraversals": 1},
    {"from": "consolidation", "outcome": "blocked", "to": "complete", "maxTraversals": 1}
  ]
}
