{
  "id": "product-build",
  "version": 4,
  "start": "discovery",
  "requiredGates": [
    "scope_approval",
    "domain_check",
    "review",
    "validation"
  ],
  "nodes": {
    "discovery": {
      "type": "agent",
      "role": "supreme-coordinator",
      "outcomes": [
        "ready",
        "blocked"
      ]
    },
    "scope_approval": {
      "type": "approval",
      "role": "user",
      "outcomes": [
        "approved",
        "rejected"
      ]
    },
    "planning": {
      "type": "agent",
      "role": "planner",
      "outcomes": [
        "ready",
        "blocked"
      ]
    },
    "domain_check": {
      "type": "agent",
      "role": "domain-coordinator",
      "outcomes": [
        "allowed",
        "question",
        "blocked"
      ]
    },
    "clarification": {
      "type": "approval",
      "role": "user",
      "outcomes": [
        "answered",
        "rejected"
      ]
    },
    "implementation": {
      "type": "agent",
      "role": "worker",
      "outcomes": [
        "completed",
        "blocked",
        "replan"
      ],
      "submissionOutcome": "completed"
    },
    "review": {
      "type": "agent",
      "role": "reviewer",
      "outcomes": [
        "passed",
        "changes_required",
        "blocked"
      ]
    },
    "validation": {
      "type": "agent",
      "role": "validator",
      "outcomes": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "complete": {
      "type": "terminal",
      "role": null,
      "outcomes": [],
      "success": true
    },
    "blocked": {
      "type": "terminal",
      "role": null,
      "outcomes": []
    }
  },
